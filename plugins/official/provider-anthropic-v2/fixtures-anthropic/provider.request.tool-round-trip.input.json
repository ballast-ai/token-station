{
  "provider_config": {
    "provider": "anthropic",
    "base_url": "https://api.anthropic.com",
    "auth": "provider_api_key",
    "models": [
      {
        "model": "claude-sonnet-4",
        "tool": true,
        "vision": true,
        "json_schema": true,
        "context_window": 200000,
        "supported_parameters": [
          "stop",
          "temperature",
          "top_p"
        ]
      }
    ]
  },
  "chat_request": {
    "model": "claude-sonnet-4",
    "messages": [
      {
        "role": "user",
        "content": "Weather in Beijing?"
      },
      {
        "role": "assistant",
        "tool_calls": [
          {
            "id": "toolu_1",
            "name": "get_weather",
            "arguments": "{\"city\":\"Beijing\"}"
          }
        ]
      },
      {
        "role": "tool",
        "tool_call_id": "toolu_1",
        "content": "18C"
      }
    ],
    "tools": [
      {
        "name": "get_weather",
        "description": "Look up weather",
        "parameters": {
          "type": "object",
          "properties": {
            "city": {
              "type": "string"
            }
          }
        }
      }
    ],
    "tool_choice": "auto",
    "sampling": {
      "max_output_tokens": 64
    }
  }
}

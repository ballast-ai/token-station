{
  "provider_config": {
    "provider": "anthropic",
    "base_url": "https://api.anthropic.com",
    "auth": "provider_api_key",
    "models": [
      {
        "model": "claude-sonnet-4",
        "tool": true,
        "vision": true,
        "json_schema": true,
        "context_window": 200000,
        "supported_parameters": [
          "stop",
          "temperature",
          "top_p"
        ]
      }
    ]
  },
  "chat_request": {
    "model": "claude-sonnet-4",
    "messages": [
      {
        "role": "system",
        "content": "You are a careful reviewer."
      },
      {
        "role": "system",
        "content": [
          {
            "type": "text",
            "text": ""
          },
          {
            "type": "text",
            "text": "Answer in one line."
          },
          {
            "type": "image_url",
            "image_url": {
              "url": "https://example/x.png"
            }
          }
        ]
      },
      {
        "role": "user",
        "content": "hi"
      }
    ],
    "sampling": {
      "max_output_tokens": 16
    }
  }
}

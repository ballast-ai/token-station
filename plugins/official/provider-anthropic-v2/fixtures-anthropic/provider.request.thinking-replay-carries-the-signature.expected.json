{
  "method": "POST",
  "url": "https://api.anthropic.com/v1/messages",
  "headers": {
    "anthropic-version": "2023-06-01",
    "content-type": "application/json"
  },
  "auth": {
    "scheme": "header",
    "name": "x-api-key",
    "secret": "provider_api_key"
  },
  "body": {
    "model": "claude-sonnet-4",
    "messages": [
      {
        "role": "user",
        "content": "Continue."
      },
      {
        "role": "assistant",
        "content": [
          {
            "type": "thinking",
            "thinking": "Weighed both options.",
            "signature": "SIG-1"
          },
          {
            "type": "redacted_thinking",
            "data": "OPAQUE"
          },
          {
            "type": "text",
            "text": "Option B."
          }
        ]
      }
    ],
    "max_tokens": 32
  }
}

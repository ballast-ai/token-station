{
  "name": "provider-openai-compatible",
  "version": "2.14.3",
  "api_version": "provider-adapter-v2",
  "providers": [
    "openai-compatible",
    "azure-openai-v1"
  ],
  "capabilities": [
    "chat",
    "json_schema",
    "stream",
    "tool_call"
  ],
  "auth_arms": [
    "bearer",
    "bearer_and_header_secret",
    "header_secret"
  ],
  "config_schema": {
    "azure-openai-v1": {
      "max_tokens_field": {
        "syntax": {
          "enum": [
            "max_completion_tokens",
            "max_tokens"
          ]
        },
        "default": "max_completion_tokens",
        "description": "The body key the output cap is sent under: max_completion_tokens (the default, as the host's native Azure OpenAI arm sends it) or max_tokens for a deployment that accepts only the legacy key. A migrated row takes the native row's max_tokens_field, else max_tokens when it cleared accepts_max_completion_tokens."
      }
    }
  },
  "model_parameters": {
    "azure-openai-v1": {
      "words": [
        "anthropic.tool_choice.auto_only",
        "reasoning_effort"
      ]
    },
    "openai-compatible": {
      "words": [
        "anthropic.tool_choice.auto_only",
        "reasoning_content",
        "reasoning_effort"
      ]
    }
  },
  "permissions": {
    "network": false,
    "filesystem": false,
    "secrets": [
      "provider_api_key"
    ]
  },
  "conformance": {
    "required_suite": "south.provider-component.v1",
    "fixtures": "fixtures/"
  },
  "compatibility": {
    "ir_schema_id": "token-station-protocol@0.7.0/v0.6.0",
    "kernel_version": "0.6.0",
    "kernel_revision": "a04925518b95c6557374252db7fbe7f026688bde",
    "wit_package": "token-station:adapter@2.0.0",
    "south_runtime": "0.83.0",
    "runtime_abi": 1,
    "kernel_contracts": {
      "canonical_ir": 5,
      "error_catalog": 1,
      "stream": 3
    }
  }
}

{
  "version": 1,
  "server": { "listen": "127.0.0.1:8787", "auth": true },
  "data": {
    "dir": "token-station-e2e/glm/data",
    "metrics": true
  },
  "plugins": {
    "dir": "token-station-e2e/plugins",
    "agent": "agent-anthropic",
    "providers": {
      "openai-compatible": "provider-openai-compatible-v2"
    }
  },
  "upstreams": {
    "glm": {
      "provider": "openai-compatible",
      "base_url": "https://open.bigmodel.cn/api/paas/v4",
      "auth": {
        "slot": "provider_api_key",
        "keyring": true
      },
      "models": [
        {
          "model": "glm-5.2",
          "tool": true,
          "context_window": 1000000,
          "supported_parameters": [
            "max_tokens",
            "stop",
            "temperature",
            "top_p"
          ]
        }
      ]
    }
  },
  "router": {
    "version": 1,
    "pools": {
      "default": [
        {
          "upstream": "glm",
          "model": "glm-5.2"
        }
      ]
    },
    "rules": [],
    "hint_routes": [],
    "default_pool": "default",
    "assumed_context_window": 1000000
  }
}

{
  "version": 1,
  "pools": {
    "cheap": [
      { "upstream": "ollama_local", "model": "llama3.3" }
    ],
    "sota": [
      { "upstream": "openai_personal", "model": "gpt-5.5" },
      { "upstream": "anthropic_personal", "model": "claude-opus-4-8" }
    ]
  },
  "rules": [
    {
      "id": "long-context",
      "when": { "estimated_input_tokens_at_least": 32000 },
      "route_to": "sota"
    },
    {
      "id": "tool-calls",
      "when": { "requires_tools": true },
      "route_to": "sota"
    },
    {
      "id": "reasoning-keywords",
      "when": { "keywords_any": ["证明", "推导", "架构", "proof", "derive"] },
      "route_to": "sota"
    }
  ],
  "hint_routes": [
    { "kind": "step_type", "value": "planning", "route_to": "sota" },
    { "kind": "step_type", "value": "summarize", "route_to": "cheap" },
    { "kind": "step_type", "value": "title", "route_to": "cheap" }
  ],
  "heuristic": {
    "weights": {
      "tokens_per_point": 100,
      "per_tool": 20,
      "json_schema": 10,
      "image": 15,
      "per_code_block": 8,
      "per_extra_turn": 3
    },
    "threshold": 40,
    "above": "sota",
    "below": "cheap"
  },
  "default_pool": "cheap",
  "assumed_context_window": 8192
}

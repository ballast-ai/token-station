// Adapter ABI, version 1.
//
// Payloads are JSON documents rather than WIT records. The Canonical IR is
// defined once, in `crates/protocol`, where exact `parse -> serialize` fixtures
// pin its wire format. Mirroring it here would give two definitions that drift,
// and WIT cannot express the open JSON values the IR carries (`tool.parameters`,
// the raw inbound `body`, and every `extensions` bag). The cost is one
// serialization per call and type errors that surface at run time; conformance
// fixtures are what catch those.
//
// Each `json` parameter names the canonical type it carries. That name is the
// contract: `crates/protocol` is the schema.
//
// The world imports neither `wasi:filesystem` nor `wasi:sockets`. An adapter
// has no file system and no network, which is what makes the host's routing,
// budget, billing and audit impossible to bypass. It imports nothing of the
// host's either: an agent adapter never even names a credential.
//
// This package carries the northbound (agent) world only. The southbound
// provider ABI is `token-station:adapter@2.0.0` (`provider-adapter-v2`), owned
// by token-station-south and loaded through `south-provider-runtime`.

package token-station:adapter@1.0.0;

/// Identity and liveness.
interface common {
    enum adapter-kind {
        agent,
    }

    record adapter-metadata {
        name: string,
        version: string,
        kind: adapter-kind,
        /// Must equal the world this adapter was built against, e.g.
        /// `agent-adapter-v1`.
        api-version: string,
    }

    enum health-status {
        ready,
        degraded,
        unavailable,
    }

    record adapter-health {
        status: health-status,
        detail: option<string>,
    }
}

/// Northbound: translates an agent tool's protocol into the Canonical IR.
interface agent-adapter {
    use common.{adapter-metadata, adapter-health};

    /// A JSON document. The doc comment on each use names its canonical type.
    type json = string;

    record agent-protocol-capability {
        /// e.g. `openai-chat-completions`
        protocol: string,
        /// Tools known to speak this protocol, e.g. `cursor`.
        agent-tools: list<string>,
    }

    record match-result {
        matched: bool,
        protocol: option<string>,
    }

    metadata: func() -> adapter-metadata;
    healthcheck: func() -> adapter-health;
    supported-agent-protocols: func() -> list<agent-protocol-capability>;

    /// `request-head`: `{ method, path, headers }`, where `headers` is a
    /// `protocol::HeaderDigest` and therefore carries no inbound credential.
    match-inbound: func(request-head: json) -> match-result;

    /// `envelope`: `protocol::AgentRequestEnvelope` -> `protocol::ChatRequest`.
    /// Errors carry a `protocol::ErrorEnvelope`.
    normalize-inbound: func(envelope: json) -> result<json, json>;

    /// `envelope`: `protocol::AgentRequestEnvelope` -> `list<protocol::AgentHint>`.
    ///
    /// Hints are routing *input*. Returning one that names a provider or a
    /// credential does not make the router honour it.
    extract-agent-hint: func(envelope: json) -> result<json, json>;

    /// `response`: `protocol::ChatResponse`, `context`: `AgentRenderContext`
    /// -> `AgentResponseEnvelope`.
    render-response: func(response: json, context: json) -> result<json, json>;

    /// `event`: `protocol::StreamEvent` -> `AgentStreamChunk`.
    ///
    /// Must render incrementally. An adapter that buffers the whole stream to
    /// render it fails the conformance suite's allocation bound.
    render-stream-event: func(event: json, context: json) -> result<json, json>;

    /// `error`: `protocol::ErrorEnvelope` -> `AgentResponseEnvelope`.
    map-inbound-error: func(error: json, context: json) -> result<json, json>;
}

/// World name doubles as the manifest's `api_version`.
world agent-adapter-v1 {
    export agent-adapter;
}

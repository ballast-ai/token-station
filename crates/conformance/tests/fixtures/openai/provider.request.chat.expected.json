{
  "method": "POST",
  "url": "https://api.openai.com/v1/chat/completions",
  "headers": {
    "content-type": "application/json"
  },
  "body": {
    "model": "gpt-5.5",
    "messages": [
      {
        "role": "user",
        "content": "Weather in Beijing?"
      }
    ],
    "stream": true,
    "stream_options": {
      "include_usage": true
    },
    "temperature": 0.2
  },
  "auth": {
    "scheme": "bearer",
    "secret": "provider_api_key"
  }
}
